# --- Required: Firebase (login + shared database) ---
# Firebase console -> Project settings (gear) -> General -> Your apps -> Web app -> SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Optional: live fare search inside the site (SerpApi, Google Flights engine) ---
# Free plan = 250 searches / month. Without this key the site still shows
# one-click price-comparison links (Google Flights, Skyscanner, Kayak, ...).
SERPAPI_KEY=

# --- Optional: live flight status tracking (aviationstack) ---
# Free plan = 100 requests / month. Without this key the Track button
# still gives links to FlightAware / Flightradar24.
AVIATIONSTACK_KEY=

# --- Optional: AI itinerary planner (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey . Without it the Itinerary tab
# shows a "not set up" message and everything else still works.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash).
GEMINI_MODEL=
